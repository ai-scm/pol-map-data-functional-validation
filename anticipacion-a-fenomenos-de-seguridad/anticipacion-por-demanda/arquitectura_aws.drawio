        <!-- ===================== LEYENDA ===================== -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Flujo de una solicitud (números en las flechas)&lt;/b&gt;&lt;br&gt;1-3 Usuario entra por Route 53 → CloudFront → ALB&lt;br&gt;4 Front (login) · 5 Login OIDC con Keycloak&lt;br&gt;6 Front → BFF (/pred_bff/*) · 7-8 BFF → ALB interno → services&lt;br&gt;9 Services valida, revisa duplicados y crea registros&lt;br&gt;10 Services lanza la tarea del motor (ecs:RunTask)&lt;br&gt;11 Motor consulta turnos en la API PONAL&lt;br&gt;12 Motor lee histórico en Athena · 13 escribe GeoJSON en S3&lt;br&gt;14 Motor marca finalizado/error · 15 lanza Glue fusión&lt;br&gt;16 Glue escribe optimización en S3 y marca fusion=true&lt;br&gt;&lt;i&gt;Línea punteada = lectura/consulta · sólida = escritura/invocación&lt;/i&gt;" vertex="1">
          <mxGeometry x="1185" y="900" width="400" height="230" as="geometry" />
        </mxCell>

