        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Procesador · qué hace con cada estación (procesar_v2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="34" as="geometry"/></mxCell>
        <mxCell id="t3" value="Una invocación por estación. Falla de SIEDCO/RNMC = falla de la estación; falla de una fuente interna = se registra y la estación sigue sin esa fuente." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1400" height="24" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;1. Evento de entrada&lt;/b&gt;&lt;br&gt;{codigo_estacion, sigla, mes, geojson_key, version: v2}&lt;br&gt;mes = mes que se procesa (YYYY-MM). La ventana de hechos son&lt;br&gt;los 3 meses que terminan en él; las fechas sugeridas caen en el mes siguiente." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Polígono de la estación&lt;/b&gt;&lt;br&gt;Lee UnidadesBase/{SIGLA}-UnidadesBase.geojson.&lt;br&gt;area_propia: quita el área de sus CAI y unidades dependientes&lt;br&gt;que tienen su propia capa (no hay zonas repetidas)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Sitios (Fuentes_externas)&lt;/b&gt;&lt;br&gt;Colegios, parques, comercio, transporte, bares, residencial…&lt;br&gt;Cada capa se clasifica en un tipo de sitio. Dan la etiqueta&lt;br&gt;de la zona y originan las zonas preventivas." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Hechos: SIEDCO + RNMC&lt;/b&gt;&lt;br&gt;SIEDCO: vista Athena con la clasificación de la capa del mapa.&lt;br&gt;RNMC: RDS hechos_z1_v2 por sigla y unidades; separa cada&lt;br&gt;comparendo por capa del mapa y quita las filas idénticas." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Fuentes internas (en paralelo)&lt;/b&gt;&lt;br&gt;SIMEP · MTRS · IRIS P1 · SIRAP · SECAD (un caso por llamada) ·&lt;br&gt;Análisis de homicidios (se cruza con SIEDCO ±1 día: ≤ 100 m es&lt;br&gt;el mismo hecho; ≤ 10 km se asocia y se muestra la distancia)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. Turnos y antecedentes&lt;/b&gt;&lt;br&gt;Turnos de la estación (turnos_dinamicos, o los 3 por defecto).&lt;br&gt;Antecedentes: hechos de los 9 meses anteriores a la ventana,&lt;br&gt;solo para justificar las zonas preventivas." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p7" value="&lt;b&gt;7. Zonificación (DBSCAN en EPSG:3116)&lt;/b&gt;&lt;br&gt;Focos de riesgo: radio 80 m y luego 120 m, ≥ 20 hechos, ≤ 350 m.&lt;br&gt;Zonas de homicidio: todo homicidio queda en una zona (300 m).&lt;br&gt;Preventivas: sitios no cubiertos, agrupados a 120 m." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p8" value="&lt;b&gt;8. Caracterización de cada zona&lt;/b&gt;&lt;br&gt;Puntaje de las 8 líneas del Manual (sitio 40 % + riesgos 60 %),&lt;br&gt;etiqueta, momento crítico, programación (turno, franja, 3 fechas),&lt;br&gt;histórico, fuentes consultadas y justificación." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p9" value="&lt;b&gt;9. Priorización&lt;/b&gt;&lt;br&gt;Zonas con homicidio: prioridad alta. Focos: ≥ 12, hasta 30,&lt;br&gt;hasta cubrir el 90 % de los hechos en focos (4 altas, el resto medias).&lt;br&gt;Preventivas: hasta 8, variadas por tipo de sitio (baja)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="550" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="p10" value="&lt;b&gt;10. Escritura&lt;/b&gt;&lt;br&gt;PutObject: policia-comunitaria/{mes}/{SIGLA}/{codigo}.geojson&lt;br&gt;(sobrescribe el de la corrida anterior; el bucket tiene versionado)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="700" width="680" height="110" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry x="0" relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="p7"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7" target="p8"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8" target="p9"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9" target="p10"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell>
        <mxCell id="t13" value="Política de fallos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="f1" value="&lt;b&gt;Si falla SIEDCO o RNMC (o el polígono, o el handler)&lt;/b&gt;&lt;br&gt;La excepción sale de la Lambda: se guarda el marcador&lt;br&gt;utilidades/errores_policia_comunitaria/{mes}/{SIGLA}/{codigo}.json&lt;br&gt;y Lambda reintenta la invocación asíncrona (2 reintentos)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="f2" value="&lt;b&gt;Si falla una fuente interna o los antecedentes&lt;/b&gt;&lt;br&gt;Se registra el error en el log y en el archivo de salida&lt;br&gt;(fuentes_internas.{fuente}.error); la estación se genera igual,&lt;br&gt;sin esa fuente. No deja marcador en S3." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="870" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="t14" value="Leyenda" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="l15" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t16" value="Fuente de datos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1016" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="l17" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="370" y="1020" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t18" value="Cómputo (Lambda / Glue / EventBridge)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="1016" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="l19" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="1020" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t20" value="Almacenamiento y consulta (S3 / Athena / RDS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="1016" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="l21" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t22" value="Servicio (BFF)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1046" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="l23" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="370" y="1050" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t24" value="Front y usuario" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="1046" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="l25" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="700" y="1050" width="24" height="16" as="geometry"/></mxCell>
        <mxCell id="t26" value="Marcador de error" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="1046" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="t27" value="Línea continua: flujo principal · línea punteada: lectura de insumos o conexión de apoyo." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1082" width="990" height="24" as="geometry"/></mxCell>
