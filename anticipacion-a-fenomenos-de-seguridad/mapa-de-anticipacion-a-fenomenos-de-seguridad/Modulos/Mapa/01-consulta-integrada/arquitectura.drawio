        <mxCell id="n_req" value="&lt;b&gt;Petición&lt;/b&gt;&lt;br&gt;POST /bff/antecedentes-comparendos-personas&lt;br&gt;Header: x-api-key&lt;br&gt;Body: {value_type:'cc', value:'222',&lt;br&gt;&amp;nbsp;&amp;nbsp;fecha_inicio:null, fecha_fin:null}&lt;br&gt;&lt;br&gt;&lt;b&gt;Respuesta 200&lt;/b&gt;&lt;br&gt;{antecedentes_personas[], comparendos[],&lt;br&gt;&amp;nbsp;&amp;nbsp;resultados_iris_p1[], metadata{...}}&lt;br&gt;Códigos: 401 sin key · 500 key inválida / error BD&lt;br&gt;422 payload inválido · 504 si supera 60 s" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A44C;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="70" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n_flow" value="&lt;b&gt;Flujo&lt;/b&gt;&lt;br&gt;1 El usuario busca en 'Consulta integrada'&lt;br&gt;2 axios arma el POST con la API key&lt;br&gt;3 HTTPS a potenciales.ia.policia.gov.co&lt;br&gt;4 Route 53 resuelve al ALB (TLS con ACM)&lt;br&gt;5 El ALB reenvía /bff/* al Target Group&lt;br&gt;6 El Target Group entrega a la tarea Fargate&lt;br&gt;7 El middleware valida la key; el router llama a CentralService&lt;br&gt;8 Consulta SIVICC, DBOPER y DISEC (por Transit Gateway) y Athena&lt;br&gt;9 El JSON vuelve por el mismo camino; el front lo pinta en el mapa" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A44C;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="320" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n_leg" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Verde: cliente · Azul: código del servicio&lt;br&gt;Naranja: servicios AWS · Rojo: seguridad&lt;br&gt;Morado: on-premise&lt;br&gt;Línea continua: flujo de la petición&lt;br&gt;Línea punteada: soporte (secretos, logs, imagen, despliegue)&lt;br&gt;Despliegue: cdk deploy actores-potenciales-stack&lt;br&gt;--exclusively (build Docker local → ECR → CloudFormation&lt;br&gt;→ ECS rolling)" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A44C;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="590" width="340" height="190" as="geometry" />
        </mxCell>
