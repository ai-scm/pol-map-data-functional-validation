<diagram id="arquitectura" name="1. Arquitectura">
  <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1010" math="0" shadow="0">
    <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Policía Comunitaria · arquitectura end to end" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t3" value="Cuenta AWS PON-PROD (926162397524) · región us-east-1 · el motor corre una vez al mes y deja un GeoJSON por estación; el front lo consulta a través del BFF." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1700" height="24" as="geometry"/></mxCell>
        <mxCell id="g4" value="1. Insumos" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="400" height="690" as="geometry"/></mxCell>
        <mxCell id="g5" value="2. Motor de zonificación (AWS Lambda)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="460" height="690" as="geometry"/></mxCell>
        <mxCell id="g6" value="3. Salida (S3)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1070" y="80" width="340" height="690" as="geometry"/></mxCell>
        <mxCell id="g7" value="4. Servicio y front" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="390" height="690" as="geometry"/></mxCell>
        <mxCell id="siedco" value="&lt;b&gt;SIEDCO · delitos y operativos&lt;/b&gt;&lt;br&gt;Oracle → Glue (01:00) → S3 → vista Athena&lt;br&gt;vw_delitos_corregido_schema_temporal" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="rnmc" value="&lt;b&gt;RNMC · comparendos&lt;/b&gt;&lt;br&gt;Glue RNMC-to-RDS (diario 09:00 Bogotá)&lt;br&gt;→ RDS PostgreSQL public.hechos_z1_v2" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="235" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="secad" value="&lt;b&gt;SECAD · casos de la línea 123&lt;/b&gt;&lt;br&gt;Lambda scheduler + Glue ETL (04:00) → S3&lt;br&gt;→ Athena pon-prod-capas-iapol (capa_11/12/13)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="disec" value="&lt;b&gt;SIMEP · MTRS · IRIS P1 · SIRAP&lt;/b&gt;&lt;br&gt;Athena pon-prod-raw-disec&lt;br&gt;y pon-prod-raw-geopol" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="445" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="hom" value="&lt;b&gt;Análisis de homicidios&lt;/b&gt;&lt;br&gt;s3://pon-prod-raw-homicidios/&lt;br&gt;buffer-presencia-policial/{fecha}.geojson" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="550" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="insumos" value="&lt;b&gt;Insumos geográficos y de turnos&lt;/b&gt;&lt;br&gt;s3://pon-prod-ml-iapol: UnidadesBase/ ·&lt;br&gt;Fuentes_externas/ · turnos_dinamicos/ ·&lt;br&gt;EstructuraNacionaOperativalPONAL.csv" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="655" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="evb" value="&lt;b&gt;EventBridge · planes-comunitarios-trigger-mensual&lt;/b&gt;&lt;br&gt;cron(0 10 1 * ? *): día 1 de cada mes, 10:00 UTC (05:00 Colombia)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="130" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="orq" value='&lt;b&gt;Lambda orquestador&lt;/b&gt;&lt;br&gt;Python 3.11 · 256 MB · 15 min&lt;br&gt;Lee UnidadesBase/*.geojson y lanza una invocación&lt;br&gt;asíncrona por estación (≈ 10 por segundo)&lt;br&gt;Manual: {"mes":"YYYY-MM", "siglas":[...]}' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="proc" value="&lt;b&gt;Lambda procesador (v2)&lt;/b&gt;&lt;br&gt;Imagen Docker · 3008 MB · 15 min · concurrencia reservada 20&lt;br&gt;handler.py → fuentes_internas.py → zonificacion_v2.py&lt;br&gt;1. Lee hechos (SIEDCO, RNMC), fuentes internas, sitios y turnos&lt;br&gt;2. Zonifica: focos, homicidios y zonas preventivas&lt;br&gt;3. Caracteriza: línea, programación y justificación&lt;br&gt;4. Escribe un GeoJSON por estación" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="420" height="220" as="geometry"/></mxCell>
        <mxCell id="sec" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;credenciales de RDS" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="640" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="logs" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;/aws/lambda/planes-comunitarios-*" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="ath" value="&lt;b&gt;Athena (primary) · resultados en s3://aws-athena-query-results-…/planes-comunitarios-v2/&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="715" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="out" value="&lt;b&gt;S3 pon-prod-ml-iapol · salida&lt;/b&gt;&lt;br&gt;policia-comunitaria/{YYYY-MM}/{SIGLA}/{codigo}.geojson&lt;br&gt;≈ 2.340 archivos · ≈ 390 MB por mes&lt;br&gt;versionado del bucket activo" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="err" value="&lt;b&gt;S3 · marcadores de error&lt;/b&gt;&lt;br&gt;utilidades/errores_policia_comunitaria/&lt;br&gt;{mes}/{SIGLA}/{codigo}.json&lt;br&gt;uno por estación que falla" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="bak" value="&lt;b&gt;S3 · respaldos manuales&lt;/b&gt;&lt;br&gt;utilidades/respaldo_policia_comunitaria_vN/&lt;br&gt;copia previa a una corrida nacional" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="450" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="usr" value="&lt;b&gt;Usuario IAPOL&lt;/b&gt;&lt;br&gt;Policía Nacional" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1480" y="130" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="front" value="&lt;b&gt;Front XCrimeApp&lt;/b&gt;&lt;br&gt;React + Mapbox GL&lt;br&gt;Botón «Policía Comunitaria» → «Consultar zonas»&lt;br&gt;Capa de relleno por etiqueta, filtros y tarjeta (popup)&lt;br&gt;Pide el mes anterior al actual" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1480" y="235" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="bff" value="&lt;b&gt;BFF capas-adicionales&lt;/b&gt;&lt;br&gt;FastAPI · ECS Fargate · ALB&lt;br&gt;https://addcapas.ia.policia.gov.co/bff&lt;br&gt;POST /bff/policia-comunitaria&lt;br&gt;{sigla, id_unidad[], anio_mes} · cabecera x-api-key&lt;br&gt;une los GeoJSON de cada unidad" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1480" y="425" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="capas" value="&lt;b&gt;Capas del mapa que deben cuadrar&lt;/b&gt;&lt;br&gt;RNMC (3 capas) · SECAD (3 capas) · SIEDCO I/II/III&lt;br&gt;Análisis de homicidios (servicio propio)&lt;br&gt;Cada fila de la tarjeta = puntos de su capa" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="615" width="350" height="125" as="geometry"/></mxCell>
